@model IEnumerable<SmartBed.Models.Hospital>

<h2>Admin Dashboard</h2>

<p>
    <a asp-action="Create" class="btn btn-success">Add Hospital</a>
</p>

<div class="row mb-4">

    <div class="col-md-4">
        <div class="card shadow border-0 bg-primary text-white">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-hospital display-4 me-3"></i>

                <div>
                    <h2>@ViewBag.TotalHospitals</h2>
                    <p class="mb-0">Total Hospitals</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow border-0 bg-success text-white">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-people-fill display-4 me-3"></i>

                <div>
                    <h2>@ViewBag.TotalUsers</h2>
                    <p class="mb-0">Total Users</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow border-0 bg-danger text-white">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-heart-pulse-fill display-4 me-3"></i>

                <div>
                    <h2>@ViewBag.TotalICUBeds</h2>
                    <p class="mb-0">Available ICU Beds</p>
                </div>
            </div>
        </div>
    </div>

</div>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Hospital</th>
            <th>Location</th>
            <th>ICU</th>
            <th>Emergency</th>
            <th>General</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.HospitalName</td>
                <td>@item.Location</td>
                <td>@item.ICUBeds</td>
                <td>@item.EmergencyBeds</td>
                <td>@item.GeneralBeds</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.HospitalId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@item.HospitalId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this hospital?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-controller="Login"
   asp-action="Logout"
   class="btn btn-danger">
    Logout
</a>