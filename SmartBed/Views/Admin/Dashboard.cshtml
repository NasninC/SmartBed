@model IEnumerable<SmartBed.Models.Hospital>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-dashboard">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- ===== HEADER ===== -->
    <div class="dashboard-header">

        <div>
            <div class="dashboard-title">
                <i class="bi bi-speedometer2"></i>
                Admin Dashboard
            </div>

            <p class="dashboard-subtitle">
                Monitor hospitals and manage real-time bed availability
            </p>
        </div>

        <div>
            <a asp-action="Create" class="add-hospital-btn">
                <i class="bi bi-plus-circle-fill"></i>
                Add Hospital
            </a>
        </div>

    </div>


    <!-- ===== STATISTICS ===== -->

    <div class="row g-4 mb-4">

        <!-- Hospitals -->
        <div class="col-lg-4 col-md-6">

            <div class="admin-stat-card hospital-stat">

                <div class="stat-icon">
                    <i class="bi bi-hospital-fill"></i>
                </div>

                <div class="stat-content">

                    <h2>@ViewBag.TotalHospitals</h2>

                    <p>Total Hospitals</p>

                    <small>
                        <i class="bi bi-check-circle-fill"></i>
                        Registered hospitals
                    </small>

                </div>

            </div>

        </div>


        <!-- Users -->
        <div class="col-lg-4 col-md-6">

            <div class="admin-stat-card user-stat">

                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div class="stat-content">

                    <h2>@ViewBag.TotalUsers</h2>

                    <p>Total Users</p>

                    <small>
                        <i class="bi bi-person-check-fill"></i>
                        Registered users
                    </small>

                </div>

            </div>

        </div>


        <!-- ICU Beds -->
        <div class="col-lg-4 col-md-6">

            <div class="admin-stat-card icu-stat">

                <div class="stat-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div class="stat-content">

                    <h2>@ViewBag.TotalICUBeds</h2>

                    <p>Available ICU Beds</p>

                    <small>
                        <i class="bi bi-activity"></i>
                        Currently available
                    </small>

                </div>

            </div>

        </div>

    </div>
    <div class="row g-4 mb-4">

        <div class="col-md-6">

            <div class="admin-stat-card pending-stat">

                <div class="stat-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div class="stat-content">

                    <h2>
                        @Model.Count(h => h.VerificationStatus == "Pending")
                    </h2>

                    <p>Pending Verification</p>

                    <small>
                        Hospitals waiting for DMO approval
                    </small>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="admin-stat-card verified-stat">

                <div class="stat-icon">
                    <i class="bi bi-patch-check-fill"></i>
                </div>

                <div class="stat-content">

                    <h2>
                        @Model.Count(h => h.VerificationStatus == "Verified")
                    </h2>

                    <p>Verified Hospitals</p>

                    <small>
                        Hospitals approved by DMO
                    </small>

                </div>

            </div>

        </div>

    </div>

    <!-- ===== HOSPITAL LIST ===== -->

    <div class="hospital-table-card">

        <div class="table-header">

            <div>
                <h4>
                    <i class="bi bi-building"></i>
                    Hospital Management
                </h4>

                <p>
                    View and manage registered hospitals
                </p>
            </div>

            <div class="hospital-count">

                <i class="bi bi-hospital"></i>

                @ViewBag.TotalHospitals Hospitals

            </div>

        </div>


        <div class="table-responsive">

            <table class="table hospital-table">

                <thead>

                    <tr>

                        <th>
                            <i class="bi bi-hospital-fill"></i>
                            Hospital
                        </th>

                        <th>
                            <i class="bi bi-geo-alt-fill"></i>
                            Location
                        </th>

                        <th>
                            <i class="bi bi-heart-pulse-fill"></i>
                            ICU
                        </th>

                        <th>
                            <i class="bi bi-ambulance-fill"></i>
                            Emergency
                        </th>

                        <th>
                            <i class="bi bi-hospital"></i>
                            General
                        </th>

                        <th>
                            <i class="bi bi-shield-check"></i>
                            Verification
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {

                        <tr>

                            <!-- Hospital -->
                            <td>

                                <div class="hospital-name">

                                    <div class="hospital-mini-icon">
                                        <i class="bi bi-hospital-fill"></i>
                                    </div>

                                    <div>
                                        <strong>
                                            @item.HospitalName
                                        </strong>

                                        <small>
                                            Hospital ID: @item.HospitalId
                                        </small>
                                    </div>

                                </div>

                            </td>


                            <!-- Location -->
                            <td>

                                <span class="location-text">

                                    <i class="bi bi-geo-alt-fill"></i>

                                    @item.Location

                                </span>

                            </td>


                            <!-- ICU -->
                            <td>

                                @if (item.ICUBeds > 0)
                                {
                                    <span class="bed-badge icu-badge">
                                        @item.ICUBeds
                                    </span>
                                }
                                else
                                {
                                    <span class="bed-badge empty-badge">
                                        0
                                    </span>
                                }

                            </td>


                            <!-- Emergency -->
                            <td>

                                @if (item.EmergencyBeds > 0)
                                {
                                    <span class="bed-badge emergency-badge">
                                        @item.EmergencyBeds
                                    </span>
                                }
                                else
                                {
                                    <span class="bed-badge empty-badge">
                                        0
                                    </span>
                                }

                            </td>


                            <!-- General -->
                            <td>

                                @if (item.GeneralBeds > 0)
                                {
                                    <span class="bed-badge general-badge">
                                        @item.GeneralBeds
                                    </span>
                                }
                                else
                                {
                                    <span class="bed-badge empty-badge">
                                        0
                                    </span>
                                }

                            </td>


                            <!-- Verification -->
                            <td>

                                @if (item.VerificationStatus == "Verified")
                                {
                                    <div class="verification-status verified-status">
                                        <i class="bi bi-patch-check-fill"></i>
                                        Verified
                                    </div>

                                    <form asp-action="RejectHospital"
                                          method="post"
                                          class="mt-2">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.HospitalId" />

                                        <button type="submit"
                                                class="reject-btn"
                                                onclick="return confirm('Are you sure you want to reject this hospital?');">

                                            <i class="bi bi-x-circle-fill"></i>
                                            Reject

                                        </button>

                                    </form>
                                }
                                else if (item.VerificationStatus == "Rejected")
                                {
                                    <div class="verification-status rejected-status">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Rejected
                                    </div>

                                    <form asp-action="VerifyHospital"
                                          method="post"
                                          class="mt-2">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.HospitalId" />

                                        <button type="submit"
                                                class="verify-btn"
                                                onclick="return confirm('Verify this hospital?');">

                                            <i class="bi bi-check-circle-fill"></i>
                                            Verify

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <div class="verification-status pending-status">
                                        <i class="bi bi-clock-fill"></i>
                                        Pending
                                    </div>

                                    <div class="mt-2">

                                        <form asp-action="VerifyHospital"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.HospitalId" />

                                            <button type="submit"
                                                    class="verify-btn"
                                                    onclick="return confirm('Verify this hospital?');">

                                                <i class="bi bi-check-circle-fill"></i>
                                                Verify

                                            </button>

                                        </form>

                                        <form asp-action="RejectHospital"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.HospitalId" />

                                            <button type="submit"
                                                    class="reject-btn"
                                                    onclick="return confirm('Reject this hospital?');">

                                                <i class="bi bi-x-circle-fill"></i>
                                                Reject

                                            </button>

                                        </form>

                                    </div>
                                }

                            </td>


                            <!-- Actions -->
                            <td>

                                <div class="action-buttons">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.HospitalId"
                                       class="edit-btn">

                                        <i class="bi bi-pencil-fill"></i>

                                        Edit

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.HospitalId"
                                       class="delete-btn"
                                       onclick="return confirm('Are you sure you want to delete this hospital?');">

                                        <i class="bi bi-trash-fill"></i>

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- ===== INFORMATION ===== -->

    <div class="dashboard-info">

        <div class="info-icon">
            <i class="bi bi-broadcast"></i>
        </div>

        <div>

            <strong>
                SmartBed Real-Time Monitoring
            </strong>

            <p>
                Hospital bed availability is continuously monitored
                and updated through the SmartBed system.
            </p>

        </div>

    </div>

</div>
