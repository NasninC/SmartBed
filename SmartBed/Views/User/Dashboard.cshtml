@model IEnumerable<SmartBed.Models.Hospital>

@{
    ViewData["Title"] = "Hospital Dashboard";

    var hospitals = Model.ToList();

    var totalHospitals = hospitals.Count;

    var availableHospitals = hospitals.Count(h =>
        h.ICUBeds > 0 ||
        h.EmergencyBeds > 0 ||
        h.GeneralBeds > 0);

    var totalICU = hospitals.Sum(h => h.ICUBeds);
    var totalEmergency = hospitals.Sum(h => h.EmergencyBeds);
    var totalGeneral = hospitals.Sum(h => h.GeneralBeds);

    var totalBeds = totalICU + totalEmergency + totalGeneral;
}


<div class="user-dashboard">


    <!-- =================================
         HERO / WELCOME SECTION
         ================================= -->

    <div class="user-hero">

        <div class="hero-content">

            <span class="user-badge">
                <i class="bi bi-broadcast"></i>
                Real-Time Healthcare
            </span>

            <h1>
                Find Available Hospital Beds
            </h1>

            <p>
                Quickly find hospitals with available ICU,
                Emergency and General beds across Kerala.
            </p>

        </div>


        <div class="hero-icon">

            <i class="bi bi-hospital-fill"></i>

        </div>

    </div>



    <!-- =================================
         STATISTICS
         ================================= -->

    <div class="row g-4 mb-4">


        <!-- Hospitals -->

        <div class="col-lg-3 col-md-6">

            <div class="user-stat-card">

                <div class="stat-icon blue">

                    <i class="bi bi-hospital-fill"></i>

                </div>

                <div>

                    <span>Total Hospitals</span>

                    <h2>@totalHospitals</h2>

                </div>

            </div>

        </div>


        <!-- Available -->

        <div class="col-lg-3 col-md-6">

            <div class="user-stat-card">

                <div class="stat-icon green">

                    <i class="bi bi-check-circle-fill"></i>

                </div>

                <div>

                    <span>Available Hospitals</span>

                    <h2>@availableHospitals</h2>

                </div>

            </div>

        </div>


        <!-- ICU -->

        <div class="col-lg-3 col-md-6">

            <div class="user-stat-card">

                <div class="stat-icon red">

                    <i class="bi bi-heart-pulse-fill"></i>

                </div>

                <div>

                    <span>ICU Beds</span>

                    <h2>@totalICU</h2>

                </div>

            </div>

        </div>


        <!-- Total Beds -->

        <div class="col-lg-3 col-md-6">

            <div class="user-stat-card">

                <div class="stat-icon purple">

                    <i class="bi bi-grid-fill"></i>

                </div>

                <div>

                    <span>Total Available Beds</span>

                    <h2>@totalBeds</h2>

                </div>

            </div>

        </div>

    </div>



    <!-- =================================
         SEARCH
         ================================= -->

    <div class="search-panel">

        <div class="search-heading">

            <div class="search-heading-icon">

                <i class="bi bi-search"></i>

            </div>

            <div>

                <h4>Find a Hospital</h4>

                <p>
                    Search by hospital name or location
                </p>

            </div>

        </div>


        <form method="get">

            <div class="row g-3">

                <div class="col-lg-9">

                    <div class="search-input">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               name="search"
                               placeholder="Search hospital or location..."
                               value="@Context.Request.Query["search"]" />

                    </div>

                </div>


                <div class="col-lg-3">

                    <div class="search-buttons">

                        <button type="submit"
                                class="search-button">

                            <i class="bi bi-search"></i>

                            Search

                        </button>

                        <a asp-action="Dashboard"
                           class="reset-button">

                            <i class="bi bi-arrow-clockwise"></i>

                            Reset

                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>



    <!-- =================================
         HOSPITAL LIST HEADER
         ================================= -->

    <div class="hospital-list-header">

        <div>

            <h3>

                <i class="bi bi-hospital"></i>

                Available Hospitals

            </h3>

            <p>
                Live bed availability
            </p>

        </div>


        <div class="live-indicator">

            <span></span>

            LIVE UPDATES

        </div>

    </div>



    <!-- =================================
         HOSPITAL CARDS
         ================================= -->

    <div class="row g-4">

        @if (!hospitals.Any())
        {

            <div class="col-12">

                <div class="no-hospitals">

                    <i class="bi bi-search"></i>

                    <h4>No hospitals found</h4>

                    <p>
                        Try searching with a different
                        hospital name or location.
                    </p>

                </div>

            </div>

        }
        else
        {

            foreach (var item in hospitals)
            {

                var isAvailable =
                item.ICUBeds > 0 ||
                item.EmergencyBeds > 0 ||
                item.GeneralBeds > 0;

                var hospitalTotal =
                item.ICUBeds +
                item.EmergencyBeds +
                item.GeneralBeds;


                <div class="col-lg-6">

                    <div class="hospital-card">


                        <!-- Card Header -->

                        <div class="hospital-card-header">

                            <div class="hospital-title">

                                <div class="hospital-logo">

                                    <i class="bi bi-hospital-fill"></i>

                                </div>

                                <div>

                                    <h4>
                                        @item.HospitalName
                                    </h4>

                                    <p>

                                        <i class="bi bi-geo-alt-fill"></i>

                                        @item.Location

                                    </p>

                                </div>

                            </div>


                            @if (isAvailable)
                            {

                                <span class="availability available">

                                    <i class="bi bi-check-circle-fill"></i>

                                    Available

                                </span>

                            }
                            else
                            {

                                <span class="availability full">

                                    <i class="bi bi-x-circle-fill"></i>

                                    Full

                                </span>

                            }

                        </div>



                        <!-- Bed Information -->

                        <div class="bed-grid">


                            <!-- ICU -->

                            <div class="bed-item">

                                <div class="bed-item-icon icu">

                                    <i class="bi bi-heart-pulse-fill"></i>

                                </div>

                                <div>

                                    <span>ICU</span>

                                    <strong>
                                        @item.ICUBeds
                                    </strong>

                                </div>

                            </div>


                            <!-- Emergency -->

                            <div class="bed-item">

                                <div class="bed-item-icon emergency">

                                    <i class="bi bi-ambulance-fill"></i>

                                </div>

                                <div>

                                    <span>Emergency</span>

                                    <strong>
                                        @item.EmergencyBeds
                                    </strong>

                                </div>

                            </div>


                            <!-- General -->

                            <div class="bed-item">

                                <div class="bed-item-icon general">

                                    <i class="bi bi-hospital-fill"></i>

                                </div>

                                <div>

                                    <span>General</span>

                                    <strong>
                                        @item.GeneralBeds
                                    </strong>

                                </div>

                            </div>

                        </div>



                        <!-- Card Footer -->
                        <!-- Card Footer -->

                        <div class="hospital-card-footer">

                            <span>
                                <i class="bi bi-grid-3x3-gap-fill"></i>

                                Total Beds:
                                <strong>@hospitalTotal</strong>
                            </span>


                            @if (isAvailable)
                            {
                                <a asp-controller="Booking"
                                   asp-action="Create"
                                   asp-route-hospitalId="@item.HospitalId"
                                   class="book-bed-btn">

                                    <i class="bi bi-calendar-check"></i>
                                    Book a Bed

                                </a>
                            }
                            else
                            {
                                <span class="full-text">
                                    <i class="bi bi-x-circle"></i>
                                    Currently Full
                                </span>
                            }

                        </div>

                    </div>

                </div>

            }

        }

    </div>



    <!-- =================================
         SIGNALR STATUS
         ================================= -->

    <div class="realtime-bar">

        <div class="realtime-icon">

            <i class="bi bi-broadcast"></i>

        </div>

        <div>

            <strong>
                Real-Time Bed Updates
            </strong>

            <p>
                Hospital bed availability automatically
                updates without refreshing the page.
            </p>

        </div>

        <div class="signal-status">

            <span></span>

            Connected

        </div>

    </div>

</div>



<!-- =================================
     SIGNALR
     ================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>

    const connection =
        new signalR.HubConnectionBuilder()
            .withUrl("/bedHub")
            .build();


    connection.on("ReceiveBedUpdate", function () {

        location.reload();

    });


    connection.start()
        .catch(function (err) {

            console.error(err.toString());

        });

</script>
