@model SmartBed.Models.Hospital


<div class="card shadow-lg border-0 rounded-4 mb-4">
    <div class="card-body">
        <h2 class="text-primary fw-bold">
            🏥 Welcome, @Model.HospitalName
        </h2>

        <p class="text-muted">
            Manage your hospital bed availability in real time.
        </p>
    </div>
</div>

<div class="row mb-4">

    <div class="col-md-4">
        <div class="card bg-danger text-white shadow rounded-4 stats-card">
            <div class="card-body text-center">
                <i class="bi bi-heart-pulse-fill display-4"></i>
                <h2>@Model.ICUBeds</h2>
                <p>ICU Beds</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-primary text-white shadow rounded-4 stats-card">
            <div class="card-body text-center">
                <i class="bi bi-ambulance-fill display-4"></i>
                <h2>@Model.EmergencyBeds</h2>
                <p>Emergency Beds</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-success text-white shadow rounded-4 stats-card">
            <div class="card-body text-center">
                <i class="bi bi-hospital-fill display-4"></i>
                <h2>@Model.GeneralBeds</h2>
                <p>General Beds</p>
            </div>
        </div>
    </div>

</div>

<form asp-action="UpdateBeds" method="post">

    <div class="card shadow rounded-4">

        <div class="card-header bg-primary text-white">
            <h4>Update Bed Availability</h4>
        </div>

        <div class="card-body">

            <!-- Paste your existing form here -->

        </div>

    </div>

    <div class="alert alert-success mt-4">
        <i class="bi bi-broadcast"></i>
        Live updates enabled using SignalR
    </div>

    <div class="text-end text-muted mt-3">
        <i class="bi bi-clock-history"></i>
        Last Updated: @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
    </div>

    <input type="hidden" asp-for="HospitalId" />

    <div class="mb-3">
        <label>Hospital Name</label>
        <input asp-for="HospitalName" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>ICU Beds</label>
        <input asp-for="ICUBeds" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Emergency Beds</label>
        <input asp-for="EmergencyBeds" class="form-control" />
    </div>

    <div class="mb-3">
        <label>General Beds</label>
        <input asp-for="GeneralBeds" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Update Beds
    </button>
    <a asp-controller="Login"
       asp-action="Logout"
       class="btn btn-danger">
        Logout
    </a>

</form>