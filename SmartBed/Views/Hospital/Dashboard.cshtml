@model SmartBed.Models.Hospital

@{
    ViewData["Title"] = "Hospital Dashboard";
}

<div class="hospital-dashboard">

    <!-- =========================
         WELCOME HEADER
         ========================= -->

    <div class="dashboard-header">

        <div>
            <span class="dashboard-badge">
                <i class="bi bi-hospital-fill"></i>
                Hospital Dashboard
            </span>

            <h1>
                Welcome, @Model.HospitalName
            </h1>

            <p>
                Manage your hospital bed availability and keep
                emergency services updated in real time.
            </p>
        </div>

        <div class="hospital-icon">
            <i class="bi bi-hospital-fill"></i>
        </div>

    </div>


    <!-- =========================
         BED STATISTICS
         ========================= -->

    <div class="row g-4 mb-4">

        <!-- ICU -->

        <div class="col-lg-4 col-md-6">

            <div class="bed-stat-card icu-card">

                <div class="bed-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div class="bed-info">

                    <span>ICU Beds</span>

                    <h2>@Model.ICUBeds</h2>

                    @if (Model.ICUBeds > 0)
                    {
                        <small>
                            <i class="bi bi-check-circle-fill"></i>
                            Beds Available
                        </small>
                    }
                    else
                    {
                        <small>
                            <i class="bi bi-x-circle-fill"></i>
                            No Beds Available
                        </small>
                    }

                </div>

            </div>

        </div>


        <!-- Emergency -->

        <div class="col-lg-4 col-md-6">

            <div class="bed-stat-card emergency-card">

                <div class="bed-icon">
                    <i class="bi bi-ambulance-fill"></i>
                </div>

                <div class="bed-info">

                    <span>Emergency Beds</span>

                    <h2>@Model.EmergencyBeds</h2>

                    @if (Model.EmergencyBeds > 0)
                    {
                        <small>
                            <i class="bi bi-check-circle-fill"></i>
                            Beds Available
                        </small>
                    }
                    else
                    {
                        <small>
                            <i class="bi bi-x-circle-fill"></i>
                            No Beds Available
                        </small>
                    }

                </div>

            </div>

        </div>


        <!-- General -->

        <div class="col-lg-4 col-md-6">

            <div class="bed-stat-card general-card">

                <div class="bed-icon">
                    <i class="bi bi-hospital-fill"></i>
                </div>

                <div class="bed-info">

                    <span>General Beds</span>

                    <h2>@Model.GeneralBeds</h2>

                    @if (Model.GeneralBeds > 0)
                    {
                        <small>
                            <i class="bi bi-check-circle-fill"></i>
                            Beds Available
                        </small>
                    }
                    else
                    {
                        <small>
                            <i class="bi bi-x-circle-fill"></i>
                            No Beds Available
                        </small>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <div class="row g-4">

        <!-- UPDATE FORM -->

        <form asp-action="UpdateBeds" method="post">

            <input type="hidden" asp-for="HospitalId" />

            <div class="card shadow rounded-4">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square"></i>
                        Update Bed Availability
                    </h4>
                </div>

                <div class="card-body">

                    <!-- Validation Summary -->

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <!-- Hospital Name -->

                    <div class="mb-3">

                        <label asp-for="HospitalName"
                               class="form-label fw-semibold">

                            <i class="bi bi-hospital-fill"></i>
                            Hospital Name

                        </label>

                        <input asp-for="HospitalName"
                               class="form-control"
                               readonly />

                    </div>


                    <!-- ICU -->

                    <div class="mb-3">

                        <label asp-for="ICUBeds"
                               class="form-label fw-semibold">

                            <i class="bi bi-heart-pulse-fill text-danger"></i>
                            ICU Beds

                        </label>

                        <input asp-for="ICUBeds"
                               type="number"
                               class="form-control"
                               min="0"
                               max="10000"
                               required />

                        <span asp-validation-for="ICUBeds"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Emergency -->

                    <div class="mb-3">

                        <label asp-for="EmergencyBeds"
                               class="form-label fw-semibold">

                            <i class="bi bi-ambulance-fill text-primary"></i>
                            Emergency Beds

                        </label>

                        <input asp-for="EmergencyBeds"
                               type="number"
                               class="form-control"
                               min="0"
                               max="10000"
                               required />

                        <span asp-validation-for="EmergencyBeds"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- General -->

                    <div class="mb-3">

                        <label asp-for="GeneralBeds"
                               class="form-label fw-semibold">

                            <i class="bi bi-hospital text-success"></i>
                            General Beds

                        </label>

                        <input asp-for="GeneralBeds"
                               type="number"
                               class="form-control"
                               min="0"
                               max="10000"
                               required />

                        <span asp-validation-for="GeneralBeds"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Update Button -->

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-check-circle-fill"></i>
                        Update Beds

                    </button>

                </div>

            </div>

        </form>


        <!-- RIGHT SIDE -->

        <div class="col-lg-4">

            <!-- LIVE STATUS -->

            <div class="live-panel">

                <div class="live-icon">
                    <i class="bi bi-broadcast"></i>
                </div>

                <h4>Real-Time Updates</h4>

                <p>
                    Your bed availability is shared with users
                    in real time using SignalR.
                </p>

                <div class="signal-status">

                    <span></span>

                    SignalR Connected

                </div>

            </div>


            <!-- LAST UPDATED -->

            <div class="updated-panel">

                <i class="bi bi-clock-history"></i>

                <div>

                    <small>Last Updated</small>

                    <strong>
                        @DateTime.Now.ToString("dd MMM yyyy")
                    </strong>

                    <span>
                        @DateTime.Now.ToString("hh:mm tt")
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>
@{
    var bookings = ViewBag.Bookings as List<SmartBed.Models.Booking>;
}

<!-- Patient Bookings -->

<div class="card shadow-lg border-0 rounded-4 mt-5">

    <div class="card-header bg-primary text-white rounded-top-4 p-3">

        <h4 class="mb-0">
            <i class="bi bi-calendar-check-fill"></i>
            Patient Bookings
        </h4>

    </div>

    <div class="card-body p-0">

        @if (bookings != null && bookings.Count > 0)
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Patient Name</th>
                            <th>Age</th>
                            <th>Phone</th>
                            <th>Bed Type</th>
                            <th>Booking Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var booking in bookings)
                        {
                            <tr>

                                <td>
                                    <span class="fw-bold text-primary">
                                        #@booking.BookingId
                                    </span>
                                </td>

                                <td>
                                    <i class="bi bi-person-circle"></i>
                                    @booking.PatientName
                                </td>

                                <td>
                                    @booking.PatientAge
                                </td>

                                <td>
                                    <i class="bi bi-telephone-fill"></i>
                                    @booking.Phone
                                </td>

                                <td>

                                    @if (booking.BedType == "ICU")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-heart-pulse-fill"></i>
                                            ICU
                                        </span>
                                    }
                                    else if (booking.BedType == "Emergency")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-ambulance-fill"></i>
                                            Emergency
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-hospital-fill"></i>
                                            General
                                        </span>
                                    }

                                </td>

                                <td>
                                    @booking.BookingDate.ToString(
                                             "dd MMM yyyy, hh:mm tt")
                                </td>

                                <td>

                                    @if (booking.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Confirmed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @booking.Status
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center p-5">

                <i class="bi bi-calendar-x display-4 text-muted"></i>

                <h5 class="mt-3">
                    No Patient Bookings
                </h5>

                <p class="text-muted mb-0">
                    No users have booked a bed at your hospital yet.
                </p>

            </div>
        }

    </div>

</div>
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
