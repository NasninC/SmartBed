@{
    ViewData["Title"] = "SmartBed";
}

<section class="hero">

    <div class="hero-overlay">

        <div class="container">

            <div class="row align-items-center" style="min-height:90vh;">

                <div class="col-md-6 text-white">

                    <h1 class="display-3 fw-bold">
                        🏥 SmartBed
                    </h1>

                    <h2 class="fw-light mb-4">
                        Emergency Bed Availability Tracking System
                    </h2>

                    <p class="lead">
                        SmartBed helps patients and ambulance services
                        locate hospitals with available ICU, Emergency,
                        and General beds in real time using SignalR.
                    </p>

                    <div class="mt-4">

                        <a asp-controller="Login"
                           asp-action="Index"
                           class="btn btn-primary btn-lg me-3">
                            Login
                        </a>

                        <a href="#features"
                           class="btn btn-outline-light btn-lg">
                            Learn More
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<section id="features" class="container py-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Why SmartBed?</h2>
        <p class="text-muted">
            A real-time hospital bed management solution.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow-lg border-0 rounded-4 text-center h-100">

                <div class="card-body">

                    <i class="bi bi-hospital-fill text-primary display-4"></i>

                    <h4 class="mt-3">Hospitals</h4>

                    <p>
                        Hospitals update ICU, Emergency and General bed
                        availability instantly.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-lg border-0 rounded-4 text-center h-100">

                <div class="card-body">

                    <i class="bi bi-ambulance-fill text-danger display-4"></i>

                    <h4 class="mt-3">Ambulance</h4>

                    <p>
                        Ambulance staff can quickly locate nearby hospitals
                        with available beds.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-lg border-0 rounded-4 text-center h-100">

                <div class="card-body">

                    <i class="bi bi-broadcast text-success display-4"></i>

                    <h4 class="mt-3">Real-Time Updates</h4>

                    <p>
                        SignalR updates bed availability instantly without
                        refreshing the page.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>