@{
    ViewData["Title"] = "SmartBed";
}

<!-- =========================================
     HERO SECTION
     ========================================= -->

<section class="smartbed-hero">

    <div class="hero-overlay"></div>

    <div class="container position-relative">

        <div class="row align-items-center min-vh-100">

            <!-- LEFT CONTENT -->

            <div class="col-lg-7">

                <div class="hero-badge">

                    <span class="live-dot"></span>

                    REAL-TIME HEALTHCARE SOLUTION

                </div>

                <h1 class="hero-title">

                    SmartBed

                    <span>
                        Smarter Hospital Bed Management
                    </span>

                </h1>

                <p class="hero-description">

                    Real-time emergency patient tracking and
                    hospital bed management designed to help
                    patients and ambulance services quickly find
                    hospitals with available beds.

                </p>


                <div class="hero-buttons">

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="btn hero-login">

                        <i class="bi bi-box-arrow-in-right"></i>

                        Login

                    </a>


                    <a href="#features"
                       class="btn hero-learn">

                        Explore SmartBed

                        <i class="bi bi-arrow-down"></i>

                    </a>

                </div>


                <div class="hero-info">

                    <div>

                        <i class="bi bi-lightning-charge-fill"></i>

                        Real-Time Updates

                    </div>

                    <div>

                        <i class="bi bi-shield-check"></i>

                        Reliable Information

                    </div>

                    <div>

                        <i class="bi bi-hospital"></i>

                        Hospital Network

                    </div>

                </div>

            </div>


            <!-- RIGHT VISUAL -->

            <div class="col-lg-5 d-none d-lg-block">

                <div class="hero-dashboard-card">

                    <div class="dashboard-card-header">

                        <div>

                            <small>SMARTBED</small>

                            <h5>Bed Availability</h5>

                        </div>

                        <div class="online-status">

                            <span></span>

                            LIVE

                        </div>

                    </div>


                    <div class="mini-hospital">

                        <div class="mini-hospital-icon">

                            <i class="bi bi-hospital-fill"></i>

                        </div>

                        <div>

                            <strong>City Hospital</strong>

                            <small>
                                <i class="bi bi-geo-alt-fill"></i>
                                Ernakulam
                            </small>

                        </div>

                        <span class="available-badge">
                            Available
                        </span>

                    </div>


                    <div class="mini-bed-grid">

                        <div class="mini-bed-card">

                            <i class="bi bi-heart-pulse-fill"></i>

                            <small>ICU</small>

                            <strong>12</strong>

                            <span>Available</span>

                        </div>


                        <div class="mini-bed-card">

                            <i class="bi bi-ambulance-fill"></i>

                            <small>Emergency</small>

                            <strong>8</strong>

                            <span>Available</span>

                        </div>


                        <div class="mini-bed-card">

                            <i class="bi bi-hospital-fill"></i>

                            <small>General</small>

                            <strong>24</strong>

                            <span>Available</span>

                        </div>

                    </div>


                    <div class="live-update-box">

                        <i class="bi bi-broadcast"></i>

                        <div>

                            <strong>Live Update</strong>

                            <small>
                                Bed availability updated instantly
                            </small>

                        </div>

                        <i class="bi bi-check-circle-fill"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================
     STATS SECTION
     ========================================= -->

<section class="stats-section">

    <div class="container">

        <div class="row g-4">


            <div class="col-md-3">

                <div class="stat-box">

                    <div class="stat-icon blue">

                        <i class="bi bi-hospital-fill"></i>

                    </div>

                    <div>

                        <h3>24/7</h3>

                        <p>Hospital Availability</p>

                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="stat-box">

                    <div class="stat-icon red">

                        <i class="bi bi-heart-pulse-fill"></i>

                    </div>

                    <div>

                        <h3>ICU</h3>

                        <p>Bed Monitoring</p>

                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="stat-box">

                    <div class="stat-icon green">

                        <i class="bi bi-broadcast"></i>

                    </div>

                    <div>

                        <h3>Live</h3>

                        <p>Real-Time Updates</p>

                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="stat-box">

                    <div class="stat-icon purple">

                        <i class="bi bi-ambulance-fill"></i>

                    </div>

                    <div>

                        <h3>Fast</h3>

                        <p>Emergency Search</p>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>



<!-- =========================================
     FEATURES
     ========================================= -->

<section id="features" class="features-section">

    <div class="container">


        <div class="section-heading">

            <span>
                WHAT SMARTBED OFFERS
            </span>

            <h2>
                Everything You Need
                <br />
                <strong>In One Place</strong>
            </h2>

            <p>
                SmartBed connects hospitals and users through
                real-time bed availability information.
            </p>

        </div>


        <div class="row g-4">


            <!-- ICU -->

            <div class="col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon red">

                        <i class="bi bi-heart-pulse-fill"></i>

                    </div>

                    <span class="feature-number">
                        01
                    </span>

                    <h4>
                        ICU Availability
                    </h4>

                    <p>
                        View the current availability of ICU
                        beds and quickly identify hospitals
                        that can accommodate critical patients.
                    </p>

                    <div class="feature-link">

                        ICU Monitoring

                        <i class="bi bi-arrow-right"></i>

                    </div>

                </div>

            </div>


            <!-- Emergency -->

            <div class="col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon blue">

                        <i class="bi bi-ambulance-fill"></i>

                    </div>

                    <span class="feature-number">
                        02
                    </span>

                    <h4>
                        Emergency Beds
                    </h4>

                    <p>
                        Find hospitals with available emergency
                        beds quickly, helping reduce unnecessary
                        delays during emergency situations.
                    </p>

                    <div class="feature-link">

                        Emergency Support

                        <i class="bi bi-arrow-right"></i>

                    </div>

                </div>

            </div>


            <!-- SignalR -->

            <div class="col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon green">

                        <i class="bi bi-broadcast"></i>

                    </div>

                    <span class="feature-number">
                        03
                    </span>

                    <h4>
                        Real-Time Updates
                    </h4>

                    <p>
                        SignalR keeps bed availability information
                        updated automatically without requiring
                        users to refresh the page.
                    </p>

                    <div class="feature-link">

                        Live Information

                        <i class="bi bi-arrow-right"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================
     HOW IT WORKS
     ========================================= -->

<section class="how-section">

    <div class="container">


        <div class="section-heading">

            <span>
                HOW IT WORKS
            </span>

            <h2>
                Simple.
                <strong>Fast.</strong>
                Real-Time.
            </h2>

            <p>
                SmartBed makes hospital bed availability
                easier to access when it matters most.
            </p>

        </div>


        <div class="row g-4">


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        01
                    </div>

                    <i class="bi bi-hospital-fill"></i>

                    <h4>
                        Hospitals Update
                    </h4>

                    <p>
                        Hospitals update their available
                        ICU, Emergency and General beds.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        02
                    </div>

                    <i class="bi bi-broadcast"></i>

                    <h4>
                        SignalR Updates
                    </h4>

                    <p>
                        Changes are delivered to connected
                        users in real time.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="step-card">

                    <div class="step-number">
                        03
                    </div>

                    <i class="bi bi-search"></i>

                    <h4>
                        Find a Hospital
                    </h4>

                    <p>
                        Users can search and identify hospitals
                        with available beds.
                    </p>

                </div>

            </div>


        </div>

    </div>

</section>



<!-- =========================================
     FINAL CTA
     ========================================= -->

<section class="cta-section">

    <div class="container">

        <div class="cta-box">

            <div>

                <span>
                    SMARTER HEALTHCARE
                </span>

                <h2>
                    Find the Right Hospital,
                    <br />
                    When It Matters.
                </h2>

                <p>
                    Access real-time hospital bed availability
                    with SmartBed.
                </p>

            </div>


            <a asp-controller="Login"
               asp-action="Index"
               class="btn cta-button">

                Get Started

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>

</section>
