@{
    ViewData["Title"] = "SmartBed";
}

<section class="hero">

    <div class="overlay">

        <div class="container-fluid px-5">

            <div class="row align-items-center" style="min-height:90vh;">

                <div class="col-lg-6">

                    <span class="badge bg-light text-primary px-3 py-2 mb-4">
                        🔵 Real-Time Healthcare Solution
                    </span>

                    <h1 class="display-2 fw-bold text-white">
                        SmartBed
                    </h1>

                    <h2 class="text-white mb-4">
                        Real-Time Emergency Patient Tracking &
                        Bed Management
                    </h2>

                    <p class="lead text-white mb-5">
                        SmartBed helps patients and ambulance services
                        quickly locate hospitals with available ICU,
                        Emergency and General beds using SignalR.
                    </p>

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="btn btn-primary btn-lg me-3">
                        Login
                    </a>

                    <a href="#features"
                       class="btn btn-outline-light btn-lg">
                        Learn More
                    </a>

                </div>


            </div>

        </div>

    </div>

</section>
<section id="features" class="py-5 bg-light">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-4">

                <div class="card shadow border-0 rounded-4">

                    <div class="card-body">

                        <i class="bi bi-heart-pulse-fill display-4 text-danger"></i>

                        <h4 class="mt-3">ICU Availability</h4>

                        <p>View real-time ICU bed availability.</p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow border-0 rounded-4">

                    <div class="card-body">

                        <i class="bi bi-ambulance-fill display-4 text-primary"></i>

                        <h4 class="mt-3">Emergency Beds</h4>

                        <p>Find hospitals with emergency beds instantly.</p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow border-0 rounded-4">

                    <div class="card-body">

                        <i class="bi bi-broadcast display-4 text-success"></i>

                        <h4 class="mt-3">SignalR Updates</h4>

                        <p>Bed availability updates without refreshing the page.</p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<section id="features" class="container py-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Why SmartBed?</h2>
        <p class="text-muted">
            A real-time hospital bed management solution.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow-lg border-0 rounded-4 text-center h-100">

                <div class="card-body">

                    <i class="bi bi-hospital-fill text-primary display-4"></i>

                    <h4 class="mt-3">Hospitals</h4>

                    <p>
                        Hospitals update ICU, Emergency and General bed
                        availability instantly.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-lg border-0 rounded-4 text-center h-100">

                <div class="card-body">

                    <i class="bi bi-ambulance-fill text-danger display-4"></i>

                    <h4 class="mt-3">Ambulance</h4>

                    <p>
                        Ambulance staff can quickly locate nearby hospitals
                        with available beds.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-lg border-0 rounded-4 text-center h-100">

                <div class="card-body">

                    <i class="bi bi-broadcast text-success display-4"></i>

                    <h4 class="mt-3">Real-Time Updates</h4>

                    <p>
                        SignalR updates bed availability instantly without
                        refreshing the page.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>