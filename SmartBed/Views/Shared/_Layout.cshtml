<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartBed</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- SmartBed CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SmartBed.styles.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>


<body>

    <!-- ==============================
         NAVBAR
         ============================== -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark"
             style="background-color:#0d6efd;">

            <div class="container">

                <!-- SmartBed Logo -->

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-hospital-fill"></i>

                    SmartBed

                </a>


                <!-- Navigation -->

                <div class="collapse navbar-collapse">

                    <ul class="navbar-nav ms-auto">


                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door-fill"></i>

                                Home

                            </a>

                        </li>


                        <!-- =========================
                             LOGIN / LOGOUT
                             ========================= -->
                        @if (
                        Context.Session.GetInt32("AdminId") != null ||
                        Context.Session.GetInt32("HospitalId") != null ||
                        Context.Session.GetInt32("UserId") != null
                        )
                        {

                            <!-- LOGOUT -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Login"
                                   asp-action="Logout">

                                    <i class="bi bi-box-arrow-right"></i>

                                    Logout

                                </a>

                            </li>

                        }
                        else
                        {

                            <!-- LOGIN -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Login"
                                   asp-action="Index">

                                    <i class="bi bi-box-arrow-in-right"></i>

                                    Login

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <!-- ==============================
         PAGE CONTENT
         ============================== -->
    @if (
    ViewContext.RouteData.Values["Controller"]?.ToString() == "Home"
    &&
    ViewContext.RouteData.Values["Action"]?.ToString() == "Index"
    )
    {

        <main role="main">

            @RenderBody()

        </main>

    }
    else
    {

        <div class="container">

            <main role="main"
                  class="pb-3">

                @RenderBody()

            </main>

        </div>

    }



    <!-- ==============================
         FOOTER
         ============================== -->

    <footer class="bg-primary text-white text-center py-4">

        <div class="container">

            <h5 class="mb-2">

                <i class="bi bi-hospital-fill"></i>

                SmartBed

            </h5>


            <p class="mb-1">

                Real-Time Emergency Patient Tracking
                & Bed Management

            </p>


            <small>

                © 2026 SmartBed |
                All Rights Reserved

            </small>

        </div>

    </footer>



    <!-- ==============================
         JAVASCRIPT
         ============================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
